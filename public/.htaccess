# heteml は .htaccess でPHPのバージョンを選ぶ。指定しないと 5.6 で動く。
AddHandler php8.3-script .php
DirectoryIndex index.php index.html

RewriteEngine On
RewriteRule ^sitemap\.xml$ sitemap.php [L]
# AIエージェント向けの発見ファイル(実体はPHPで台帳から動的生成)
RewriteRule ^llms\.txt$ llms.php [L]
RewriteRule ^catalog\.json$ catalog.php [L]
# 分野ページ /c-<slug>（フォルダを掘ると共通ヘッダーの相対リンクが壊れるので平らな形）
RewriteRule ^c-([a-z-]+)$ c.php?c=$1 [L,QSA]
# 末尾の / 付き（/news/・/seido/・/news-bousai/ など）は、/ なしへ 302 で移す（2026-11-08）。
# 同じページを / 付きで返すと、ページ内の相対リンク（news-ai・app.php?id=…）が /news/news-ai にずれて壊れる。
# 301 はブラウザが恒久にキャッシュして取り消せないので使わない（feedback_no_301_redirect）。
RewriteRule ^((?:news|seido)(?:-[a-z0-9-]+)?)/$ /$1 [R=302,L]
# AI・IT・DXニュース（2026-11-07）。/news・/news-<話題>・/news-<日付>（分野ページと同じく平らな形）
RewriteRule ^news$ news.php [L,QSA]
RewriteRule ^news-(ai|security|dx|bousai)$ news.php?t=$1 [L,QSA]
RewriteRule ^news-([0-9]{4}-[0-9]{2}-[0-9]{2})$ news.php?d=$1 [L,QSA]
# 業務の制度ニュース（2026-11-07）。/seido・/seido-<分類>
RewriteRule ^seido$ seido.php [L,QSA]
RewriteRule ^seido-(roumu|joho|shien|torihiki|tetsuzuki)$ seido.php?c=$1 [L,QSA]

# 実行時設定と台帳は直接読ませない（PHPが止まったときにソースが出るため）
<FilesMatch "^(kapp_config\.php|simpletrack_config\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# アクセスログ（SimpleTrack）は直接読ませない
<FilesMatch "^(access-.*\.log|\.st_salt)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
